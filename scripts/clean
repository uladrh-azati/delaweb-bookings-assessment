#!/usr/bin/env bash
set -euo pipefail

task_dir="$(cd "$(dirname "$0")/.." && pwd)"

for app_dir in "$task_dir"/apps/*/; do
  app_name=$(basename "$app_dir")
  app_clean="$app_dir/scripts/clean"
  if [ -f "$app_clean" ]; then
    echo "  cleaning apps/$app_name"
    bash "$app_clean"
  else
    echo "  warning: apps/$app_name has no scripts/clean"
  fi
done

rm -rf "$task_dir/node_modules"
rm -f "$task_dir/.env"
